# Copy this file to ".env" and fill it in. NEVER commit the real .env.

# SQLite file for development (created in server/prisma/dev.db).
# Later, switch to PostgreSQL by changing the provider in schema.prisma
# and this URL to something like postgresql://user:pass@localhost:5432/roomlynk
DATABASE_URL="file:./dev.db"

# Used to sign login tokens. Make it long and random. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

PORT=3000
CLIENT_ORIGIN="http://localhost:5173"
