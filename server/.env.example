# Copy this file to ".env" and fill it in. NEVER commit the real .env.

# PostgreSQL connection (CLAUDE.md section 10).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Create the database and a dedicated app user first (not the "postgres" administrator).
# Use a password made only of letters, digits, "-" and "_" so it needs no URL-encoding.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
DATABASE_URL="postgresql://roomlynk_app:CHANGE_ME@localhost:5432/roomlynk"

# Used to sign login tokens. Make it long and random. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

PORT=3000
CLIENT_ORIGIN="http://localhost:5173"